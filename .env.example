# Ember environment variables.
#
# Nothing here is required yet. The whole app runs on the stubbed walker
# data in endpoints.sv.jac with every one of these unset. Fill in real
# values once a track wires up an actual provider.

# --- Speech-to-text (voice track) ---
STT_PROVIDER=
STT_API_KEY=

# --- Text-to-speech (voice track) ---
TTS_PROVIDER=
TTS_API_KEY=

# --- Conversational replies (voice track, replaces the SendMessage stub) ---
LLM_API_KEY=
